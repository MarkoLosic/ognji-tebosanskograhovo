rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isProgrammer() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role == "programmer";
    }

    function isEditor() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role in ["programmer", "admin"];
    }

    match /content/{docId} {
      allow read: if true;
      allow write: if isEditor();
    }

    match /gallery/{docId} {
      allow read: if true;
      allow write: if isEditor();
    }

    match /roles/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow write: if isProgrammer();
    }
  }
}
